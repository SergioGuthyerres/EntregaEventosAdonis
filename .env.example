# =============================================================================
# Variáveis de ambiente — copie para .env:   cp .env.example .env
# O arquivo .env NÃO é versionado (.gitignore) e NÃO entra na imagem (.dockerignore).
# =============================================================================

# ---- Aplicação --------------------------------------------------------------
TZ=UTC
LOG_LEVEL=info
# Chave de criptografia da aplicação (obrigatória). Gere uma com:
#   openssl rand -base64 32
# ou (Windows/PowerShell, sem openssl):
#   docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=6BXVzjiSwFYIgj3MW7gMCKT3XjroSfFemTugwB5JJrs=

# ---- Banco de dados (PostgreSQL) -------------------------------------------
# O container do Postgres é criado com estas credenciais e a API as usa para conectar.
DB_USER=eventos
DB_PASSWORD=troque_esta_senha
DB_DATABASE=eventos

# ---- Docker -----------------------------------------------------------------
# Porta do HOST onde a API ficará disponível (http://localhost:API_PORT)
API_PORT=3333
# Usuário do Docker Hub e tag da imagem (docker pull <usuario>/controle-eventos-api:<tag>)
DOCKERHUB_USER=sergioguthyerres
IMAGE_TAG=latest

# =============================================================================
# Somente para rodar SEM Docker (node ace serve --hmr), descomente:
# =============================================================================
# NODE_ENV=development
# HOST=localhost
# PORT=3333
# APP_URL=http://localhost:3333
# SESSION_DRIVER=cookie
# DB_HOST=127.0.0.1
# DB_PORT=5432
